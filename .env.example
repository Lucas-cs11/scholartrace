# ============ LLM（可选，B0 基线不需要；parser/rerank 需要时再填）============
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat            # 深度重排/复杂步骤用强模型
# LLM_FAST_MODEL=deepseek-chat       # 解析/轻摘要用低成本模型

# ============ 学术搜索 API ============
# OpenAlex / Crossref 无需 key，可直接使用
# Semantic Scholar 无 key 限流较严（100 req/5min）；免费申请 key 提高限流
# SEMANTIC_SCHOLAR_API_KEY=
# 建议填邮箱进入 OpenAlex polite pool（更高限流），非必填
# OPENALEX_MAILTO=you@example.com

# ============ 预算默认值 ============
# BUDGET_MAX_API_CALLS=50
# BUDGET_MAX_ROUNDS=4
# BUDGET_MAX_TOKENS_PER_QUERY=20000
# TOP_K=20
