# dev — 开发环境（宿主机端口 8100）
#
# 本文件不含任何密钥，可入库。密钥在仓库外：见 ST_SECRETS_FILE。
#
# 用法：docker compose --env-file deploy/env/dev.env up -d --build
#
# 配置取向：迭代要快、不能烧配额。所以召回走 crossref（免费无配额），
# 预算与 top_k 都压小，日志开到 debug。

# --- 供 compose 插值 ---
ST_ENV=dev
ST_PORT=8100
ST_SECRETS_FILE=/mnt/scholartrace/secrets/.env

# --- 应用读取（pydantic-settings，见 config/settings.py）---
RECALL_SOURCE=crossref
BUDGET_MAX_API_CALLS=20
TOP_K=10

# --- uvicorn 读取（小写：uvicorn 的 --log-level 只认小写）---
LOG_LEVEL=debug
