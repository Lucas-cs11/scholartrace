# prod — 生产环境（宿主机端口 8102）
#
# 本文件不含任何密钥，可入库。密钥在仓库外：见 ST_SECRETS_FILE。
#
# 用法：docker compose --env-file deploy/env/prod.env up -d
#
# 配置取向：与 staging 应用配置一致（预发就是照生产验的），仅日志级别更高——
# 生产只记 warning 以上，避免正常请求把日志刷满。

# --- 供 compose 插值 ---
ST_ENV=prod
ST_PORT=8102
ST_SECRETS_FILE=/mnt/scholartrace/secrets/.env

# --- 应用读取（pydantic-settings，见 config/settings.py）---
RECALL_SOURCE=openalex
BUDGET_MAX_API_CALLS=50
TOP_K=20

# --- uvicorn 读取（小写：uvicorn 的 --log-level 只认小写）---
LOG_LEVEL=warning
