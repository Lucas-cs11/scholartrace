# staging — 预发环境（宿主机端口 8101）
#
# 本文件不含任何密钥，可入库。密钥在仓库外：见 ST_SECRETS_FILE。
#
# 用法：docker compose --env-file deploy/env/staging.env up -d
#
# 配置取向：按生产形态跑——真实召回源、生产预算、生产 top_k。
# 预发的意义就是在与 prod 同形的配置下验证，所以这两个文件的应用配置刻意保持一致，
# 差异只在日志级别。

# --- 供 compose 插值 ---
ST_ENV=staging
ST_PORT=8101
ST_SECRETS_FILE=/mnt/scholartrace/secrets/.env

# --- 应用读取（pydantic-settings，见 config/settings.py）---
RECALL_SOURCE=openalex
BUDGET_MAX_API_CALLS=50
TOP_K=20

# --- uvicorn 读取（小写：uvicorn 的 --log-level 只认小写）---
LOG_LEVEL=info
